{
  "name": "dsh-ocsf-forwarder",
  "version": "0.1.0",
  "description": "Read-side SIEM forwarder for DeepSeek Harness: normalises session activity to OCSF and ships it",
  "license": "MIT",
  "author": "Ivan Tyshchenko <nsof@protonmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharlotteN7/dsh-ocsf-forwarder.git"
  },
  "bugs": {
    "url": "https://github.com/CharlotteN7/dsh-ocsf-forwarder/issues"
  },
  "homepage": "https://github.com/CharlotteN7/dsh-ocsf-forwarder#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ocsf",
    "siem",
    "otlp",
    "audit-log",
    "security"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "pnpm run build && vitest run --config vitest.e2e.config.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-telemetry": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-mock-server": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}
